// TODO: GraphicsInit/GraphicsTerminate is also responsible
// for initializing/releasing the input system, so maybe we
// should separate it by concerns.

int WINAPI WinMain(HINSTANCE hinstance, HINSTANCE hprevinstance, PSTR pScmdline, int iCmdshow)
{
    // Get pointer to global window handle.
    WINDOW* window = &windowHandle;
    if (WindowInit(window, L"amogus", 800, 600)) {
        fprintf(stderr, "%s: Failed to open a Window!\n", __func__);
        return -1;
    }

    if (GraphicsInit(window)) {
        fprintf(stderr, "%s: Failed to initialize graphics!\n", __func__);
        return -1;
    }

    // Initialize application.
    if (AppInit(window)) {
        fprintf(stderr, "%s: Failed to initialize application client!\n", __func__);
        return -1;
    }

    fprintf(stderr, "Initialized application!\n");

    // Run graphics system.
    GraphicsRun();

    // Release the application.
    AppShutdown();
    GraphicsTerminate();

    fprintf(stderr, "%s: Closed window!\n", __func__);

    return 0;
}

